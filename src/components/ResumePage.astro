---
/**
 * The résumé page. Shared by both locales — but the two documents behind it are
 * not translations of each other: Taiwanese and international conventions
 * differ on ordering and on what belongs in one at all. Only the frame is
 * common.
 */
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import { CONTENT_DIR, type Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  locale: Locale;
  alternates: Partial<Record<Locale, string | null>>;
  /** Filename under public/, generated by scripts/build-resume-pdf.mjs. */
  pdf: string;
  /** What the browser should call the file when saved. */
  pdfFilename: string;
  downloadLabel: string;
  subtitle: string;
  jobTitle: string;
};

const {
  locale,
  alternates,
  pdf,
  pdfFilename,
  downloadLabel,
  subtitle,
  jobTitle,
} = Astro.props;

const t = useTranslations(locale);
const entryId = `${CONTENT_DIR[locale]}/resume`;
const resume = await getEntry("pages", entryId);

if (!resume) {
  throw new Error(`Missing content entry: src/content/pages/${entryId}.md`);
}

const { Content } = await render(resume);

// The page is the résumé; the PDF is generated from it. Marking up the same
// facts as structured data means a search result can show them without anyone
// opening the file.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: t.siteName,
    alternateName: config.site.author,
    url: config.site.url,
    email: "alan930604@gmail.com",
    jobTitle,
    address: {
      "@type": "PostalAddress",
      addressLocality: locale === "en" ? "Taichung" : "臺中市",
      addressCountry: "TW",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name:
        locale === "en"
          ? "National Chin-Yi University of Technology"
          : "國立勤益科技大學",
    },
    sameAs: [
      "https://github.com/alanlin0604",
      "https://www.linkedin.com/in/chenghanlin-tw/",
    ],
  },
};
---

<Layout
  title={`${resume.data.title} | ${t.siteName}`}
  description={resume.data.description}
  {alternates}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <Header {alternates} />

  <main id="main-content" class="app-layout my-1">
    <nav class="mt-8 mb-1 print:hidden" aria-label="breadcrumb">
      <ul class="flex flex-wrap items-center gap-x-1 font-light">
        <li class="flex items-center gap-x-1">
          <a href={getRelativeLocaleUrl(locale, "")} class="opacity-80">
            {t.nav.home}
          </a>
          <span aria-hidden="true" class="opacity-80">&raquo;</span>
        </li>
        <li>
          <span class="opacity-75" aria-current="page">{resume.data.title}</span>
        </li>
      </ul>
    </nav>

    <header
      class="border-border flex flex-wrap items-end justify-between gap-4 border-b pb-6"
    >
      <div>
        <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{t.siteName}</h1>
        <p class="text-muted-foreground mt-2">{subtitle}</p>
      </div>

      <a
        href={getAssetPath(pdf)}
        download={pdfFilename}
        class="border-border hover:border-accent hover:text-accent rounded-sm border px-3 py-2 text-sm font-medium print:hidden"
      >
        {downloadLabel}
      </a>
    </header>

    <article class="app-prose resume mt-8 w-full">
      <Content />
    </article>
  </main>

  <Footer class="print:hidden" />
</Layout>

<style>
  /* The résumé is denser than the site's reading pages: it is scanned, not read
     start to finish. Tighter rhythm, and the section rules do the work that
     whitespace does elsewhere. */
  .resume :global(h2) {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
    margin-top: 2.5rem;
    font-size: 1.25rem;
  }

  .resume :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.25rem;
    font-size: 1.0625rem;
  }

  /* The line under each role — employer, dates, links — is metadata, not prose,
     so it sits quieter and closer to its heading. */
  .resume :global(h3 + p) {
    margin-top: 0;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .resume :global(li) {
    margin-block: 0.35rem;
  }

  /* The skills table is label/value, not a grid of equals. Without a floor on
     the label column the browser gives it the narrowest fit and breaks short
     labels mid-word. */
  .resume :global(table) {
    width: 100%;
    table-layout: fixed;
  }

  .resume :global(th:first-child),
  .resume :global(td:first-child) {
    width: 22%;
  }

  @media (width < 40rem) {
    .resume :global(th:first-child),
    .resume :global(td:first-child) {
      width: 30%;
    }
  }
</style>
