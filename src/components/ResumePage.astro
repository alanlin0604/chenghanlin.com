---
/**
 * The résumé page. Shared by both locales — but the two documents behind it are
 * not translations of each other: Taiwanese and international conventions
 * differ on ordering and on what belongs in one at all. Only the frame is
 * common.
 */
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import { CONTENT_DIR, type Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  locale: Locale;
  alternates: Partial<Record<Locale, string | null>>;
  /** Filename under public/, generated by scripts/build-resume-pdf.mjs. */
  pdf: string;
  /** What the browser should call the file when saved. */
  pdfFilename: string;
  downloadLabel: string;
  subtitle: string;
  jobTitle: string;
};

const {
  locale,
  alternates,
  pdf,
  pdfFilename,
  downloadLabel,
  subtitle,
  jobTitle,
} = Astro.props;

const t = useTranslations(locale);
const entryId = `${CONTENT_DIR[locale]}/resume`;
const resume = await getEntry("pages", entryId);

if (!resume) {
  throw new Error(`Missing content entry: src/content/pages/${entryId}.md`);
}

const { Content } = await render(resume);

// The page is the résumé; the PDF is generated from it. Marking up the same
// facts as structured data means a search result can show them without anyone
// opening the file.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: t.siteName,
    alternateName: config.site.author,
    url: config.site.url,
    email: "alan930604@gmail.com",
    jobTitle,
    address: {
      "@type": "PostalAddress",
      addressLocality: locale === "en" ? "Taichung" : "臺中市",
      addressCountry: "TW",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name:
        locale === "en"
          ? "National Chin-Yi University of Technology"
          : "國立勤益科技大學",
    },
    sameAs: [
      "https://github.com/alanlin0604",
      "https://www.linkedin.com/in/chenghanlin-tw/",
    ],
  },
};
---

<Layout
  title={`${resume.data.title} | ${t.siteName}`}
  description={resume.data.description}
  {alternates}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <Header {alternates} />

  <main id="main-content" class="app-layout my-1">
    <nav class="mt-8 mb-1 print:hidden" aria-label="breadcrumb">
      <ul class="flex flex-wrap items-center gap-x-1 font-light">
        <li class="flex items-center gap-x-1">
          <a href={getRelativeLocaleUrl(locale, "")} class="opacity-80">
            {t.nav.home}
          </a>
          <span aria-hidden="true" class="opacity-80">&raquo;</span>
        </li>
        <li>
          <span class="opacity-75" aria-current="page">{resume.data.title}</span>
        </li>
      </ul>
    </nav>

    <header
      class="border-border flex flex-wrap items-end justify-between gap-4 border-b pb-6"
    >
      <div>
        <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{t.siteName}</h1>
        <p class="text-muted-foreground mt-2">{subtitle}</p>
      </div>

      <a
        href={getAssetPath(pdf)}
        download={pdfFilename}
        class="border-border hover:border-accent hover:text-accent rounded-sm border px-3 py-2 text-sm font-medium print:hidden"
      >
        {downloadLabel}
      </a>
    </header>

    <article class="app-prose resume mt-8 w-full">
      <Content />
    </article>
  </main>

  <Footer class="print:hidden" />
</Layout>

<style>
  /* The résumé is denser than the site's reading pages: it is scanned, not read
     start to finish. Tighter rhythm, and the section rules do the work that
     whitespace does elsewhere. */
  .resume :global(h2) {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
    margin-top: 2.5rem;
    font-size: 1.25rem;
  }

  .resume :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.25rem;
    font-size: 1.0625rem;
  }

  /* The line under each role — employer, dates, links — is metadata, not prose,
     so it sits quieter and closer to its heading. */
  .resume :global(h3 + p) {
    margin-top: 0;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .resume :global(li) {
    margin-block: 0.3rem;
  }

  /* ===== Labelled entries =====
     A résumé is scanned before it is read, so the label opening each bullet is
     where a reader's eye lands. Inline, it did not survive contact with
     Chinese: the sentence ran on from the label and wrapped back underneath at
     the same indent, so the label dissolved into the paragraph and the block
     read as one grey slab.
     Giving the label its own line produces a column of entry points, and a rule
     down the left edge groups each label with its own body — which a bullet dot
     beside the first line only never did.

     The selector keys on structure, not on where the bold happens to sit. An
     earlier version used `li > strong:first-child`, which is wrong for a reason
     worth recording: CSS pseudo-classes ignore text nodes, so a bold word in
     the middle of a sentence is also the first *element* child. LapseWatch's
     "notifies **before** it renews" was duly rendered as a heading. A label
     paragraph followed by a body paragraph cannot be confused for that. */
  .resume :global(li:has(> p:first-child > strong):has(> p + p)) {
    list-style: none;
    margin-inline-start: -1.25rem;
    margin-block: 1rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid var(--border);
  }

  .resume :global(li:has(> p + p) > p:first-child > strong) {
    color: var(--accent);
    font-size: 0.9375rem;
    letter-spacing: 0.03em;
  }

  /* A loose list gives every paragraph the prose margin, which is far too much
     air between a label and the sentence it labels. */
  .resume :global(li > p) {
    margin-block: 0;
  }

  .resume :global(li > p + p) {
    margin-top: 0.15rem;
  }

  /* The skills table is a label/value list, not a grid of equal cells. Ruled
     boxes around every value add noise to something meant to be skimmed, so
     only the row separators survive. A floor on the label column stops the
     browser giving it the narrowest possible fit and breaking short labels
     mid-word. */
  /* Auto layout, not fixed. `table-layout: fixed` takes its column widths from
     the first row — and the header row here is visually hidden out of flow, so
     the browser found no width to use and fell back to splitting the table down
     the middle, leaving the values in half the space they needed. Auto layout
     plus a non-wrapping label column gives the labels exactly what they need
     and the values everything else. */
  .resume :global(table) {
    width: 100%;
    table-layout: auto;
    font-size: 0.9375rem;
  }

  .resume :global(thead) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .resume :global(td) {
    border: 0;
    border-bottom: 1px solid var(--border);
    padding-block: 0.6rem;
    padding-inline: 0 0.75rem;
    vertical-align: baseline;
  }

  .resume :global(tr:last-child td) {
    border-bottom: 0;
  }

  .resume :global(td:first-child) {
    width: 1%;
    white-space: nowrap;
    font-weight: 600;
    color: var(--muted-foreground);
  }

  @media (width < 40rem) {
    /* Two columns of Chinese at phone width leaves the value column too narrow
       to read, so the pair stacks instead. */
    .resume :global(table),
    .resume :global(tbody),
    .resume :global(tr),
    .resume :global(td) {
      display: block;
      width: auto;
    }

    .resume :global(tr) {
      border-bottom: 1px solid var(--border);
      padding-block: 0.6rem;
    }

    .resume :global(tr:last-child) {
      border-bottom: 0;
    }

    .resume :global(td) {
      border-bottom: 0;
      padding-block: 0;
    }

    .resume :global(td:first-child) {
      width: auto;
      white-space: normal;
      margin-bottom: 0.15rem;
    }
  }
</style>
