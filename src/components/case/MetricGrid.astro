---
/**
 * Quantified results. Rendered as real text rather than an image of a slide,
 * so the numbers are selectable, searchable and readable at any width.
 */
type Metric = {
  value: string;
  label: string;
  note: string;
};

type Props = {
  metrics: Metric[];
  /** Shown under the grid, e.g. the validation setup these came from. */
  caption?: string;
};

const { metrics, caption } = Astro.props;
---

<div class="not-prose mt-6">
  <dl class="grid grid-cols-1 gap-px sm:grid-cols-2">
    {
      metrics.map(({ value, label, note }) => (
        <div class="border-border border-t py-4 sm:pe-6">
          <dt class="sr-only">{label}</dt>
          <dd>
            <span class="text-accent block text-3xl font-bold tabular-nums">
              {value}
            </span>
            <span class="mt-1 block font-medium">{label}</span>
            <span class="text-muted-foreground mt-0.5 block text-sm">
              {note}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>

  {
    caption && (
      <p class="text-muted-foreground border-border mt-4 border-t pt-3 text-sm">
        {caption}
      </p>
    )
  }
</div>
