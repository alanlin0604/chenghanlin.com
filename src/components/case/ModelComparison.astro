---
/**
 * The five candidate algorithms, compared on the criteria that actually decided
 * the choice.
 *
 * Algorithms are rows rather than columns (the slide had it the other way
 * round) so that the mobile layout, which stacks rows into blocks, groups each
 * algorithm with its own criteria instead of scattering them.
 *
 * Both language versions are written out rather than translated at render time:
 * "低・純 CPU ＜50ms" and "sub-50 ms, CPU only" are the same fact phrased for
 * different readers, and a shared string table would force one of them to read
 * like a translation of the other.
 */
import { resolveLocale, type Locale } from "@/i18n/locales";

type Table = {
  criteria: [string, string, string, string, string];
  chosenNote: string;
  rows: {
    name: string;
    chosen?: boolean;
    values: [string, string, string, string, string];
  }[];
};

const TABLES: Record<Locale, Table> = {
  "zh-Hant": {
    criteria: [
      "資料量需求",
      "可解釋性",
      "推論成本",
      "過擬合風險",
      "準確度與穩定度",
    ],
    chosenNote: "★ 選用",
    rows: [
      {
        name: "線性迴歸",
        values: [
          "少量即可",
          "高（係數）",
          "極低",
          "易欠擬合",
          "受限於線性假設",
        ],
      },
      {
        name: "單一決策樹",
        values: ["少量即可", "高（規則）", "極低", "高（易過擬）", "不穩定"],
      },
      {
        name: "Random Forest",
        chosen: true,
        values: [
          "幾百筆即可訓練",
          "中高（特徵重要度）",
          "低・純 CPU ＜50ms",
          "低（Bagging 天然抗過擬）",
          "高・穩定且幾乎免調參",
        ],
      },
      {
        name: "XGBoost",
        values: [
          "中等需求",
          "中高（特徵重要度）",
          "低",
          "中（需調參）",
          "高（調參後常略勝）",
        ],
      },
      {
        name: "LSTM",
        values: [
          "需大量（萬筆＋）",
          "低（黑箱）",
          "高（需 GPU）",
          "高（資料少時）",
          "高（資料足時）",
        ],
      },
    ],
  },
  en: {
    criteria: [
      "Data needed",
      "Interpretability",
      "Inference cost",
      "Overfitting risk",
      "Accuracy and stability",
    ],
    chosenNote: "★ chosen",
    rows: [
      {
        name: "Linear regression",
        values: [
          "Very little",
          "High (coefficients)",
          "Negligible",
          "Tends to underfit",
          "Capped by the linearity assumption",
        ],
      },
      {
        name: "Single decision tree",
        values: [
          "Very little",
          "High (explicit rules)",
          "Negligible",
          "High",
          "Unstable",
        ],
      },
      {
        name: "Random Forest",
        chosen: true,
        values: [
          "A few hundred rows",
          "Medium-high (feature importance)",
          "Low — sub-50 ms, CPU only",
          "Low (bagging resists it)",
          "High, stable, near zero tuning",
        ],
      },
      {
        name: "XGBoost",
        values: [
          "Moderate",
          "Medium-high (feature importance)",
          "Low",
          "Medium (needs tuning)",
          "High once tuned, often best",
        ],
      },
      {
        name: "LSTM",
        values: [
          "Tens of thousands of rows",
          "Low (opaque)",
          "High (needs a GPU)",
          "High on small data",
          "High with enough data",
        ],
      },
    ],
  },
};

const locale = resolveLocale(Astro.currentLocale);
const { criteria, chosenNote, rows } = TABLES[locale];

const CAPTION =
  locale === "en"
    ? "Five candidate algorithms compared on data requirements, interpretability, inference cost, overfitting risk and accuracy"
    : "五種候選演算法在資料量需求、可解釋性、推論成本、過擬合風險與準確度上的比較";

const STACK_LABEL = locale === "en" ? "Algorithm" : "演算法";
---

<figure class="not-prose case-wide mt-6">
  <div class="overflow-x-auto">
    <table class="model-comparison w-full border-collapse text-sm">
      <caption class="sr-only">{CAPTION}</caption>
      <thead>
        <tr class="border-border border-b-2">
          <th scope="col" class="py-2 pe-3 text-start font-semibold">
            {STACK_LABEL}
          </th>
          {
            criteria.map(criterion => (
              <th scope="col" class="py-2 pe-3 text-start font-semibold">
                {criterion}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ name, chosen, values }) => (
            <tr
              class:list={[
                "border-border border-b align-top",
                chosen && "bg-accent/8",
              ]}
            >
              <th
                scope="row"
                class:list={[
                  "py-3 pe-3 text-start font-semibold whitespace-nowrap",
                  chosen && "text-accent",
                ]}
              >
                {name}
                {chosen && <span class="ms-1 text-xs">{chosenNote}</span>}
              </th>
              {values.map((value, index) => (
                <td
                  data-label={criteria[index]}
                  class:list={["py-3 pe-3", chosen && "font-medium"]}
                >
                  {value}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>

<style>
  /* Below the small breakpoint a six-column comparison cannot be read without
     horizontal scrolling, so each row collapses into a labelled block. Same
     DOM, same semantics — only the presentation changes. */
  @media (width < 40rem) {
    .model-comparison thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .model-comparison,
    .model-comparison tbody,
    .model-comparison tr,
    .model-comparison th,
    .model-comparison td {
      display: block;
    }

    .model-comparison tr {
      padding-block: 0.75rem;
    }

    .model-comparison tr > th[scope="row"] {
      font-size: 1rem;
      padding-bottom: 0.25rem;
    }

    .model-comparison td {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding-block: 0.25rem;
    }

    .model-comparison td::before {
      content: attr(data-label);
      color: var(--muted-foreground);
      flex: none;
    }
  }
</style>
