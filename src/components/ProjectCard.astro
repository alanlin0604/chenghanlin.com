---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { resolveLocale } from "@/i18n/locales";
import { useTranslations } from "@/i18n";
import type { CollectionEntry } from "astro:content";

type Props = {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
};

const { project, headingLevel = "h3" } = Astro.props;
const { title, tagline, stack, liveUrl, repoUrl, pageSlug, hasPage, caseStudy } =
  project.data;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Until the case study exists the title is plain text and the reader is sent to
// the live site or the repository instead — linking to a page that is not built
// yet would ship a 404 on the most-visited page of the site.
const caseStudyHref = hasPage
  ? getRelativeLocaleUrl(locale, `projects/${pageSlug}`)
  : undefined;

const Heading = headingLevel;
---

<li class="border-border border-b py-6 last:border-b-0">
  <Heading class="text-xl font-semibold">
    {
      caseStudyHref ? (
        <a href={caseStudyHref} class="hover:text-accent">
          {title}
        </a>
      ) : (
        title
      )
    }
  </Heading>

  <p class="measure text-foreground mt-2">{tagline}</p>

  {
    stack.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1" aria-label="Stack">
        {stack.map(item => (
          <li class="chip">{item}</li>
        ))}
      </ul>
    )
  }

  <p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
    {
      caseStudyHref && (
        <a href={caseStudyHref} class="link-underline font-medium">
          {caseStudy ? t.projects.readCaseStudy : title}
          <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
        </a>
      )
    }
    {
      liveUrl && (
        <a href={liveUrl} class="link-underline">
          {t.projects.liveDemo}
        </a>
      )
    }
    {
      repoUrl && (
        <a href={repoUrl} class="link-underline">
          {t.projects.sourceCode}
        </a>
      )
    }
  </p>
</li>
