---
/**
 * Shown on a home page when the reader arrived from the language switcher on a
 * page that has no counterpart in this language. Hidden by default and revealed
 * by `#lang-fallback:target` (see global.css) — no JavaScript involved, so it
 * still works with scripting disabled.
 *
 * Carries `--accent-soft` rather than a yellow or orange warning tint: nothing
 * has gone wrong, the reader is simply somewhere other than where they aimed.
 * It has no dismiss control — a `role="status"` that can be closed is a banner,
 * and banners get ignored.
 */
import { FALLBACK_HASH, resolveLocale } from "@/i18n/locales";
import { useTranslations } from "@/i18n";

const t = useTranslations(resolveLocale(Astro.currentLocale));
---

<div
  id={FALLBACK_HASH}
  role="status"
  class="border-accent bg-accent-soft measure mt-6 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-s-2 px-5 py-3.5"
>
  <span class="eyebrow text-accent font-mono whitespace-nowrap">
    {t.lang.fallbackEyebrow}
  </span>
  <span>{t.lang.fallbackBody}</span>
</div>
