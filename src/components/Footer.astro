---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();

/* The bare hostname, no scheme: this is a signature at the foot of a page, not
   a link someone is meant to copy. */
const { hostname } = new URL(config.site.url);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border rail flex flex-col items-center justify-between gap-4 border-t py-8 sm:flex-row sm:py-6"
  >
    <div class="flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t.footer.allRightsReserved}</span>
    </div>

    <span>{hostname}</span>
  </div>
</footer>
