---
/**
 * A project page. Shared by both locales so the two routes cannot drift —
 * everything that differs between them comes from the content entry and the
 * translation table, not from a second copy of this markup.
 *
 * One component covers both the twenty-minute case study and the two pages
 * that are a few paragraphs long. Nothing is padded to make the short ones
 * look like the long one: a section that has no data behind it in the entry's
 * frontmatter does not appear at all, and the page simply ends earlier.
 */
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleToc from "@/components/ArticleToc.astro";
import MetricGrid from "@/components/case/MetricGrid.astro";
import { getProjects } from "@/utils/getProjects";
import { useTranslations } from "@/i18n";
import type { Locale } from "@/i18n/locales";
import config from "@/config";

type Props = {
  project: CollectionEntry<"projects">;
  locale: Locale;
  /** Counterpart URLs; dynamic routes cannot be inferred from filenames. */
  alternates: Partial<Record<Locale, string | null>>;
};

const { project, locale, alternates } = Astro.props;
const {
  title,
  description,
  tagline,
  liveUrl,
  repoUrl,
  stack,
  role,
  period,
  kind,
  scope,
  metrics,
  metricsCaption,
  screenshot,
  screenshotAlt,
} = project.data;
const { Content, headings } = await render(project);

const t = useTranslations(locale);

/* Two sections do not need a table of contents — the reader can see both of
   them without scrolling, and a list of two is furniture, not navigation. */
const sections = headings.filter(heading => heading.depth === 2);
const showToc = sections.length >= 3;

const siblings = await getProjects(locale);
const position = siblings.findIndex(entry => entry.id === project.id);
const previous = position > 0 ? siblings[position - 1] : undefined;
const next = position >= 0 ? siblings[position + 1] : undefined;

const projectHref = (entry: CollectionEntry<"projects">) =>
  getRelativeLocaleUrl(locale, `projects/${entry.data.pageSlug}`);

/* The hostname is the label; the scheme is noise on a page that is already
   about this one product. */
const liveLabel = liveUrl ? new URL(liveUrl).hostname : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  applicationCategory: "HealthApplication",
  abstract: tagline,
  url: liveUrl,
  codeRepository: repoUrl,
  author: {
    "@type": "Person",
    name: config.site.author,
    url: config.site.url,
  },
  isAccessibleForFree: true,
};
---

<Layout
  title={`${title} | ${t.siteName}`}
  description={description ?? tagline}
  {alternates}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <Header {alternates} />

  <div id="top" class="app-layout pt-10 pb-20">
    <nav class="rail" aria-label="breadcrumb">
      <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-accent">
        {t.nav.home}
      </a>
      <span aria-hidden="true"> / </span>
      <a
        href={getRelativeLocaleUrl(locale, "projects")}
        class="hover:text-accent"
      >
        {t.projects.sectionTitle}
      </a>
      <span aria-hidden="true"> / </span>
      <span class="text-foreground" aria-current="page">{title}</span>
    </nav>

    <div
      class="mt-7 grid items-start gap-x-14 gap-y-8 lg:grid-cols-[13.75rem_1fr]"
    >
      {
        /* Everything a reader wants before deciding to read on: who built it,
          when, with what, and where it is. Down the margin rather than in the
          text, so the body can open on the product instead of on a datasheet. */
      }
      <dl class="rail">
        <dt class="rail-title text-muted-foreground">{t.projects.role}</dt>
        <dd class="text-foreground mt-1">{role}</dd>

        <dt class="rail-title text-muted-foreground mt-4">
          {t.projects.period}
        </dt>
        <dd class="text-foreground mt-1">{period}</dd>

        {
          kind && (
            <Fragment>
              <dt class="rail-title text-muted-foreground mt-4">
                {t.projects.kind}
              </dt>
              <dd class="text-foreground mt-1">{kind}</dd>
            </Fragment>
          )
        }

        {
          scope.length > 0 && (
            <Fragment>
              <dt class="rail-title text-muted-foreground mt-4">
                {t.projects.scope}
              </dt>
              <dd class="text-foreground mt-1">
                {scope.map(line => (
                  <span class="block">{line}</span>
                ))}
              </dd>
            </Fragment>
          )
        }

        {
          stack.length > 0 && (
            <Fragment>
              <dt class="rail-title text-muted-foreground mt-4">
                {t.projects.stack}
              </dt>
              <dd class="mt-1.5 flex flex-wrap gap-x-1.5 gap-y-1">
                {stack.map(item => (
                  <span class="chip">{item}</span>
                ))}
              </dd>
            </Fragment>
          )
        }

        {
          (liveUrl || repoUrl) && (
            <Fragment>
              <dt class="rail-title text-muted-foreground mt-4">
                {t.projects.links}
              </dt>
              {/* No trailing ↗. The rail is 234px and a hostname like
                  `lapsewatch.smallworks.app` fills all of it in the monospace
                  face, so the arrow lands alone on a second line — and whether
                  it does depends on which mono font the reader's OS resolves,
                  which is not something to leave to chance. The heading above
                  and the accent colour already say these lead off the site. */}
              <dd class="mt-1 flex flex-col gap-1">
                {liveUrl && (
                  <a
                    href={liveUrl}
                    class="text-accent wrap-anywhere hover:underline"
                  >
                    {liveLabel}
                  </a>
                )}
                {repoUrl && (
                  <a
                    href={repoUrl}
                    class="text-accent wrap-anywhere hover:underline"
                  >
                    {t.projects.sourceCode}
                  </a>
                )}
              </dd>
            </Fragment>
          )
        }
      </dl>

      <div class="min-w-0">
        <h1
          class="measure text-4xl leading-[1.22] font-bold sm:text-[3.375rem]"
        >
          {title}
        </h1>

        <p class="measure mt-5 text-lg">{tagline}</p>

        {
          /* Whichever of the two the entry has the material for. A page with
             measured results leads on them; a page without leads on the
             problem it exists to solve. Neither is padded to look like the
             other — that is the whole degradation rule, in one branch. */
          metrics.length > 0 ? (
            <MetricGrid
              {metrics}
              caption={metricsCaption}
              title={t.projects.results}
            />
          ) : (
            <div class="border-accent bg-accent-soft measure mt-7 border-s-2 px-6 py-4.5">
              <p class="rail rail-title text-accent">{t.projects.problem}</p>
              <p class="mt-1.5">{project.data.problem}</p>
            </div>
          )
        }
      </div>
    </div>

    <div
      class="mt-12 grid items-start gap-x-14 gap-y-8 lg:grid-cols-[13.75rem_1fr]"
    >
      <div class="rail lg:sticky lg:top-6">
        {
          showToc && (
            <nav aria-label={t.post.toc}>
              <details class="border-border border p-3 lg:hidden">
                <summary class="text-accent rail-title cursor-pointer">
                  {t.post.toc}
                </summary>
                <div class="mt-2.5">
                  <ArticleToc {headings} numbered={metrics.length > 0} />
                </div>
              </details>

              <div class="hidden lg:block">
                <p class="rail-title mb-2.5">{t.post.toc}</p>
                <ArticleToc {headings} numbered={metrics.length > 0} />

                {/* A plain anchor, so it works with scripting off — which is
                    also why it is not a floating button. */}
                <p class="border-border mt-4 border-t pt-3">
                  <a href="#top" class="hover:text-accent">
                    <span aria-hidden="true">↑&nbsp;</span>
                    {t.post.backToTop}
                  </a>
                </p>
              </div>
            </nav>
          )
        }
      </div>

      <main id="main-content" class="min-w-0">
        {
          /* At the full width of the column rather than beside the text. The
            pages without metrics or diagrams are a single 38rem measure inside
            a 948px column, and the screenshot is what makes the rest of that
            width mean something. */
        }
        {
          screenshot && (
            <Image
              src={screenshot}
              alt={screenshotAlt ?? ""}
              class="border-border mb-10 w-full border"
              widths={[640, 950, 1450, 1900]}
              sizes="(min-width: 64rem) 950px, 100vw"
            />
          )
        }

        <article class="app-prose w-full">
          <Content />
        </article>

        <nav
          class="border-border measure mt-11 grid gap-6 border-t pt-5 sm:grid-cols-2"
          aria-label={t.projects.adjacentLabel}
        >
          {
            previous ? (
              <a href={projectHref(previous)} class="hover:text-accent">
                <span class="rail rail-title block">
                  {t.projects.previousProject}
                </span>
                <span class="mt-1 block font-bold">{previous.data.title}</span>
                {previous.data.label && (
                  <span class="rail block">{previous.data.label}</span>
                )}
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a
                href={projectHref(next)}
                class="hover:text-accent sm:col-start-2 sm:text-end"
              >
                <span class="rail rail-title block">
                  {t.projects.nextProject}
                </span>
                <span class="mt-1 block font-bold">{next.data.title}</span>
                {next.data.label && (
                  <span class="rail block">{next.data.label}</span>
                )}
              </a>
            )
          }
        </nav>

        <p class="rail mt-8">
          <a
            href={getRelativeLocaleUrl(locale, "projects")}
            class="hover:text-accent"
          >
            <span aria-hidden="true">←&nbsp;</span>{t.projects.backToIndex}
          </a>
        </p>
      </main>
    </div>
  </div>

  <Footer />
</Layout>
