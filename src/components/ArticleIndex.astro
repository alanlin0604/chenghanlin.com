---
/**
 * The article listing. Shared by both locales, and it shows every article
 * regardless of the language it was written in — with a badge saying which.
 *
 * The brief is explicit that articles are not mirrored: forcing parity doubles
 * the maintenance and ends with neither side updated. Hiding the pieces written
 * in the other language would be the other failure — a reader would never know
 * they exist.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getArticles, articleUrl } from "@/utils/getArticles";
import { useTranslations } from "@/i18n";
import { HREFLANG, type Locale } from "@/i18n/locales";

type Props = {
  locale: Locale;
  alternates: Partial<Record<Locale, string | null>>;
  description: string;
};

const { locale, alternates, description } = Astro.props;
const t = useTranslations(locale);
const articles = await getArticles();

const dateFormat = new Intl.DateTimeFormat(
  locale === "en" ? "en-GB" : "zh-Hant-TW",
  { year: "numeric", month: "long", day: "numeric", timeZone: "Asia/Taipei" }
);
---

<Layout title={`${t.nav.posts} | ${t.siteName}`} {description} {alternates}>
  <Header {alternates} />

  <main id="main-content" class="app-layout my-1">
    <header class="pt-8 pb-2">
      <h1 class="text-3xl font-bold sm:text-4xl">{t.nav.posts}</h1>
      <p class="measure text-muted-foreground mt-4">{t.articles.intro}</p>
    </header>

    {
      articles.length === 0 ? (
        <p class="border-border text-muted-foreground mt-6 border-t py-8">
          {t.articles.empty}
        </p>
      ) : (
        <ol class="mt-4">
          {articles.map(article => {
            const { title, description: summary, pubDatetime, lang } =
              article.data;
            const foreign = lang !== locale;
            return (
              <li class="border-border border-t py-8">
                <h2 class="text-2xl font-semibold">
                  <a href={articleUrl(article)} class="hover:text-accent">
                    {title}
                  </a>
                </h2>

                <p class="text-muted-foreground mt-1 flex flex-wrap items-center gap-x-3 text-sm">
                  <time datetime={pubDatetime.toISOString()}>
                    {dateFormat.format(pubDatetime)}
                  </time>
                  <span
                    lang={HREFLANG[lang]}
                    class:list={[
                      "border-border rounded-sm border px-2 py-0.5 text-xs",
                      foreign && "border-accent text-accent",
                    ]}
                  >
                    {lang === "en" ? t.articles.inEnglish : t.articles.inChinese}
                  </span>
                </p>

                <p class="measure mt-3">{summary}</p>

                {foreign && (
                  <p class="text-muted-foreground mt-2 text-sm">
                    {t.articles.otherLanguageNote}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      )
    }
  </main>

  <Footer />
</Layout>
