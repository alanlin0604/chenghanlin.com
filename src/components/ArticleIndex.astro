---
/**
 * The article listing. Shared by both locales. Each article appears once, in
 * this reader's language — the badge and note only show up if a piece has no
 * translation yet, which is a gap to fix rather than a state to design around.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import {
  getArticlesFor,
  articleUrl,
  articleLocale,
} from "@/utils/getArticles";
import { useTranslations } from "@/i18n";
import { HREFLANG, type Locale } from "@/i18n/locales";

type Props = {
  locale: Locale;
  alternates: Partial<Record<Locale, string | null>>;
  description: string;
};

const { locale, alternates, description } = Astro.props;
const t = useTranslations(locale);
const articles = await getArticlesFor(locale);

import { formatDate } from "@/utils/formatDate";
---

<Layout title={`${t.nav.posts} | ${t.siteName}`} {description} {alternates}>
  <Header {alternates} />

  <main id="main-content" class="app-layout my-1">
    <header class="pt-8 pb-2">
      <h1 class="text-3xl font-bold sm:text-4xl">{t.nav.posts}</h1>
      <p class="measure text-muted-foreground mt-4">{t.articles.intro}</p>
    </header>

    {
      articles.length === 0 ? (
        <p class="border-border text-muted-foreground mt-6 border-t py-8">
          {t.articles.empty}
        </p>
      ) : (
        <ol class="mt-4">
          {articles.map(article => {
            const {
              title,
              description: summary,
              pubDatetime,
              tags,
            } = article.data;
            const lang = articleLocale(article);
            const foreign = lang !== locale;
            return (
              <li class="border-border border-t py-8">
                <p class="text-muted-foreground flex flex-wrap items-center gap-x-3 text-sm">
                  <time datetime={pubDatetime.toISOString()}>
                    {formatDate(pubDatetime, locale)}
                  </time>
                  {/* Only worth saying when it is not the reader's language —
                      a badge on every row would be pure noise. */}
                  {foreign && (
                    <span
                      lang={HREFLANG[lang]}
                      class="border-accent text-accent rounded-sm border px-2 py-0.5 text-xs"
                    >
                      {lang === "en"
                        ? t.articles.inEnglish
                        : t.articles.inChinese}
                    </span>
                  )}
                </p>

                <h2 class="mt-1 text-2xl font-semibold">
                  <a href={articleUrl(article)} class="hover:text-accent">
                    {title}
                  </a>
                </h2>

                <p class="measure mt-3">{summary}</p>

                {tags.length > 0 && (
                  <ul
                    class="mt-4 flex flex-wrap gap-x-2 gap-y-1"
                    aria-label={t.post.tagLabel}
                  >
                    {tags.map(tag => (
                      <li class="chip">{tag}</li>
                    ))}
                  </ul>
                )}

                {foreign && (
                  <p class="text-muted-foreground mt-3 text-sm">
                    {t.articles.otherLanguageNote}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      )
    }
  </main>

  <Footer />
</Layout>
