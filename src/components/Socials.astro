---
import config from "@/config";
import LinkButton from "./LinkButton.astro";

type Props = {
  /**
   * `icon` is the row of glyphs; `text` writes the names out, which is what
   * the contact block wants — three icons under an email address read as
   * decoration, three words read as three more ways to reach someone.
   */
  variant?: "icon" | "text";
};

const { variant = "icon" } = Astro.props;

const { site, socials } = config;

/** "mail" is the icon file's name, not a label anyone would write. */
const LABELS: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  mail: "Email",
  x: "X",
  facebook: "Facebook",
  telegram: "Telegram",
  whatsapp: "WhatsApp",
  pinterest: "Pinterest",
};

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (url.startsWith("mailto:") || name === "mail"
        ? `Send an email to ${site.title}`
        : `${site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`);
    return {
      url,
      title,
      Icon,
      label: LABELS[name] ?? name.charAt(0).toUpperCase() + name.slice(1),
    };
  })
);
---

{
  variant === "text" ? (
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
      {items.map(({ url, title, label }) => (
        <a href={url} title={title} class="hover:text-accent">
          {label}
        </a>
      ))}
    </div>
  ) : (
    <div class="flex flex-wrap items-center gap-1">
      {items.map(({ url, title, Icon }) =>
        Icon ? (
          <LinkButton
            href={url}
            class="p-2 hover:rotate-6 sm:p-1"
            title={title}
          >
            <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
            <span class="sr-only">{title}</span>
          </LinkButton>
        ) : null
      )}
    </div>
  )
}
