---
/**
 * An article page. Rendered in the language the article was written in, so
 * <html lang> always matches the text on screen.
 *
 * Two columns: a sticky rail carrying the way out and the way around, and the
 * article itself at the reading measure. The rail is what earns the page its
 * width — the text column is the same 38rem it has always been.
 */
import { render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleToc from "@/components/ArticleToc.astro";
import { useTranslations, tplStr } from "@/i18n";
import type { Locale } from "@/i18n/locales";
import {
  articleLocale,
  articleUrl,
  getArticlesFor,
  type Article,
} from "@/utils/getArticles";
import { readingMinutes } from "@/utils/readingTime";
import { formatDate } from "@/utils/formatDate";
import config from "@/config";

type Props = {
  article: Article;
  locale: Locale;
  alternates: Partial<Record<Locale, string | null>>;
};

const { article, locale, alternates } = Astro.props;
const { title, description, pubDatetime, modDatetime, tags } = article.data;
const { Content, headings } = await render(article);

const t = useTranslations(locale);
const minutes = readingMinutes(article.body ?? "");

/* Neighbours come from the same list the index shows, in the same order, so
   "previous" means what a reader who came from that page expects it to mean:
   one row up, not one step further into the past. */
const siblings = await getArticlesFor(locale);
const position = siblings.findIndex(entry => entry.id === article.id);
const previous = position > 0 ? siblings[position - 1] : undefined;
const next = position >= 0 ? siblings[position + 1] : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: pubDatetime.toISOString(),
  dateModified: (modDatetime ?? pubDatetime).toISOString(),
  inLanguage: articleLocale(article),
  author: {
    "@type": "Person",
    name: config.site.author,
    url: config.site.url,
  },
};
---

<Layout title={`${title} | ${t.siteName}`} {description} {alternates}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <Header {alternates} />

  <div
    class="app-layout grid items-start gap-x-12 gap-y-8 pt-12 pb-20 lg:grid-cols-[13.75rem_1fr]"
  >
    <div class="rail lg:sticky lg:top-6">
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class="hover:text-accent block"
      >
        <span aria-hidden="true">←&nbsp;</span>{t.articles.all}
      </a>

      {
        headings.some(h => h.depth === 2) && (
          <nav aria-label={t.post.toc}>
            {/* Native disclosure on phones — no script, and the focus ring
                lands on the whole box rather than on the summary text. The
                same list is a plain rail item once there is room for it. */}
            <details class="border-border mt-4 border p-3 lg:hidden">
              <summary class="text-accent rail-title cursor-pointer">
                {t.post.toc}
              </summary>
              <div class="mt-2.5">
                <ArticleToc {headings} />
              </div>
            </details>

            <div class="mt-4 hidden lg:block">
              <p class="rail-title mb-2.5">{t.post.toc}</p>
              <ArticleToc {headings} />
            </div>
          </nav>
        )
      }
    </div>

    {
      /* `min-w-0`: a grid track sizes to its content by default, so a wide code
        block or table stretches the column instead of scrolling inside it —
        and takes the whole page sideways with it at 320px. */
    }
    <main id="main-content" class="min-w-0">
      <header>
        <p class="rail rail-title text-muted-foreground">
          <time datetime={pubDatetime.toISOString()}>
            {formatDate(pubDatetime, locale)}
          </time>
          <span aria-hidden="true"> · </span>
          {tplStr(t.post.readingTime, { minutes })}
        </p>

        <h1
          class="measure mt-3.5 text-4xl leading-[1.3] font-bold sm:text-[2.75rem]"
        >
          {title}
        </h1>

        <p class="measure text-muted-foreground mt-4 text-lg">{description}</p>

        {
          tags.length > 0 && (
            <ul
              class="mt-4 flex flex-wrap gap-x-2 gap-y-1"
              aria-label={t.post.tagLabel}
            >
              {tags.map(tag => (
                <li class="tag-chip">{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      <article class="app-prose border-border mt-8 w-full border-t pt-7">
        <Content />
      </article>

      {
        (previous || next) && (
          <nav
            class="border-border measure mt-10 grid gap-6 border-t pt-5 sm:grid-cols-2"
            aria-label={t.post.adjacentLabel}
          >
            {previous && (
              <a href={articleUrl(previous)} class="hover:text-accent group">
                <span class="rail rail-title block">{t.post.previousPost}</span>
                <span class="mt-1 block font-bold">{previous.data.title}</span>
              </a>
            )}
            {next && (
              <a
                href={articleUrl(next)}
                class="hover:text-accent group sm:col-start-2 sm:text-end"
              >
                <span class="rail rail-title block">{t.post.nextPost}</span>
                <span class="mt-1 block font-bold">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </main>
  </div>

  <Footer />
</Layout>
