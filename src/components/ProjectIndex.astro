---
/**
 * The projects index. Shared by both locales.
 *
 * Deliberately different from the home page cards: the home page answers "what
 * has he built" in ten seconds, this answers "which one should I open" — so it
 * carries the role, the period and the problem each project exists to solve.
 */
import { type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import type { Locale } from "@/i18n/locales";

type Props = {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
  alternates: Partial<Record<Locale, string | null>>;
  description: string;
};

const { projects, locale, alternates, description } = Astro.props;
const t = useTranslations(locale);
---

<Layout
  title={`${t.projects.sectionTitle} | ${t.siteName}`}
  {description}
  {alternates}
>
  <Header {alternates} />

  <main id="main-content" class="app-layout my-1">
    <nav class="mt-8 mb-1" aria-label="breadcrumb">
      <ul class="flex flex-wrap items-center gap-x-1 font-light">
        <li class="flex items-center gap-x-1">
          <a href={getRelativeLocaleUrl(locale, "")} class="opacity-80">
            {t.nav.home}
          </a>
          <span aria-hidden="true" class="opacity-80">&raquo;</span>
        </li>
        <li>
          <span class="opacity-75" aria-current="page">
            {t.projects.sectionTitle}
          </span>
        </li>
      </ul>
    </nav>

    <header class="pb-2">
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">
        {t.projects.sectionTitle}
      </h1>
      <p class="measure text-muted-foreground mt-4">{t.projects.indexIntro}</p>
    </header>

    <ol class="mt-4">
      {
        projects.map(project => {
          const {
            title,
            role,
            period,
            problem,
            stack,
            pageSlug,
            hasPage,
            caseStudy,
          } = project.data;
          const href = hasPage
            ? getRelativeLocaleUrl(locale, `projects/${pageSlug}`)
            : undefined;
          return (
            /* The case study gets weight the others do not. The intro says
               HeartBox is the one worth reading, and until now the list said
               the opposite by giving all three identical treatment — the
               reader had to take the claim on trust rather than see it. */
            <li
              class:list={["project-entry border-border border-t py-8", { featured: caseStudy }]}
            >
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h2 class="text-2xl font-semibold">
                  {href ? (
                    <a href={href} class="hover:text-accent">
                      {title}
                    </a>
                  ) : (
                    title
                  )}
                </h2>
                {caseStudy && (
                  <span class="eyebrow text-accent">
                    {t.projects.caseStudyLabel}
                  </span>
                )}
              </div>

              <p class="text-muted-foreground mt-1 text-sm">
                {role}
                <span aria-hidden="true"> ・ </span>
                {period}
              </p>

              <p class="measure mt-4">{problem}</p>

              {stack.length > 0 && (
                <ul
                  class="mt-4 flex flex-wrap gap-x-2 gap-y-1"
                  aria-label="Stack"
                >
                  {stack.map(item => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
              )}

              {href && (
                <p class="mt-5">
                  <a href={href} class="link-underline font-medium">
                    {caseStudy
                      ? t.projects.readCaseStudy
                      : `${t.projects.readPage} ${title}`}
                    <span aria-hidden="true"> →</span>
                  </a>
                </p>
              )}
            </li>
          );
        })
      }
    </ol>
  </main>

  <Footer />
</Layout>

<style>
  /* The case study is marked with an accent rule down its left edge rather
     than a heavier rule on top. Two reasons: a top border has to compete with
     the separator every other entry already has — Tailwind resolves
     `border-border` and `border-accent` by stylesheet order, not by the order
     they appear in the class list, so which colour won was luck — and a left
     rule reads as "this whole entry", not "something starts here". */
  .project-entry.featured {
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: 1.25rem;
  }
</style>
