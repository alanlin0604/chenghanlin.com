---
/**
 * The projects index. Shared by both locales.
 *
 * Deliberately different from the home page cards: the home page answers "what
 * has he built" in ten seconds, this answers "which one should I open" — so it
 * carries the role, the period and the problem each project exists to solve.
 *
 * The flagship keeps the card; the other two are rows. Giving all three the
 * same treatment made the intro's claim that one of them is worth reading
 * properly something the reader had to take on trust rather than see.
 */
import { type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import type { Locale } from "@/i18n/locales";

type Props = {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
  alternates: Partial<Record<Locale, string | null>>;
  description: string;
};

const { projects, locale, alternates, description } = Astro.props;
const t = useTranslations(locale);

const featured = projects.find(entry => entry.data.caseStudy);
const others = projects.filter(entry => entry !== featured);

const hrefFor = (entry: CollectionEntry<"projects">) =>
  entry.data.hasPage
    ? getRelativeLocaleUrl(locale, `projects/${entry.data.pageSlug}`)
    : undefined;
---

<Layout
  title={`${t.projects.sectionTitle} | ${t.siteName}`}
  {description}
  {alternates}
>
  <Header {alternates} />

  <main id="main-content" class="app-layout rail-grid pt-14 pb-20">
    <div class="rail">
      <p class="rail-title text-accent">{t.projects.sectionTitle}</p>
      <p class="mt-1">{t.projects.indexCount}</p>
    </div>

    <div class="min-w-0">
      <h1 class="text-4xl font-bold">{t.projects.sectionTitle}</h1>
      <p class="measure mt-4 text-lg">{t.projects.indexIntro}</p>

      {
        featured && (
          <article class="border-border mt-11 border-t pt-8">
            {/* Above the text and at the column's full width, not beside it in
                a 446px slot. The screenshot is a dashboard card 2240px wide; at
                446 that is a fivefold reduction and the chart's own heading and
                axis labels land four pixels tall. More source pixels cannot fix
                that — only more room can. */}
            {featured.data.screenshot ? (
              <Image
                src={featured.data.screenshot}
                alt={featured.data.screenshotAlt ?? ""}
                class="border-border mb-7 aspect-[5/2] w-full border object-cover"
                widths={[640, 1000, 1600, 2000]}
                sizes="(min-width: 64rem) 1000px, 100vw"
              />
            ) : (
              <div class="border-border screenshot-pending mb-7 flex aspect-[5/2] items-center justify-center border">
                <span class="bg-background border-border text-muted-foreground rail border px-3 py-1.5">
                  {featured.data.title}
                </span>
              </div>
            )}

            <div class="min-w-0">
              <p class="rail rail-title text-accent">
                {t.projects.caseStudyLabel}
              </p>

              <h2 class="mt-1.5 text-3xl font-bold">
                {hrefFor(featured) ? (
                  <a href={hrefFor(featured)} class="hover:text-accent">
                    {featured.data.title}
                  </a>
                ) : (
                  featured.data.title
                )}
              </h2>

              <p class="rail mt-1.5">
                {featured.data.role}
                <span aria-hidden="true"> · </span>
                {hrefFor(featured) ? (
                  <a
                    href={hrefFor(featured)}
                    class="text-accent hover:underline"
                  >
                    {t.projects.readCaseStudy} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  featured.data.period
                )}
              </p>

              <p class="measure mt-4">{featured.data.tagline}</p>

              {featured.data.metrics.length > 0 && (
                <dl class="border-border mt-6 grid grid-cols-2 border-y sm:grid-cols-4">
                  {featured.data.metrics.map(({ value, label, data }) => (
                    <div class="border-border border-e py-3 pe-4 last:border-e-0 last:pe-0 sm:ps-4 sm:first:ps-0 [&:nth-child(2)]:border-e-0 [&:nth-child(2)]:pe-0 sm:[&:nth-child(2)]:border-e sm:[&:nth-child(2)]:pe-4">
                      <dd
                        class:list={[
                          "font-mono text-2xl leading-none font-medium tabular-nums",
                          data ? "text-chart" : "text-foreground",
                        ]}
                      >
                        {value}
                      </dd>
                      <dt class="text-muted-foreground mt-1.5 text-sm">
                        {label}
                      </dt>
                    </div>
                  ))}
                </dl>
              )}

              {featured.data.stack.length > 0 && (
                <ul
                  class="mt-5 flex flex-wrap gap-x-2 gap-y-1"
                  aria-label={t.projects.stack}
                >
                  {featured.data.stack.map(item => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        )
      }

      {
        others.length > 0 && (
          <section class="mt-14">
            <h2 class="rail rail-title text-muted-foreground">
              {t.projects.otherProjects}
            </h2>

            <ol class="mt-4">
              {others.map(entry => {
                const href = hrefFor(entry);
                const { title, tagline, stack, role, period } = entry.data;
                return (
                  <li class="border-border grid items-start gap-x-8 gap-y-4 border-t py-7 sm:grid-cols-[1fr_13.75rem]">
                    <div class="measure">
                      <h3 class="text-xl font-bold">
                        {href ? (
                          <a href={href} class="hover:text-accent">
                            {title}
                          </a>
                        ) : (
                          title
                        )}
                      </h3>

                      <p class="mt-2.5">{tagline}</p>

                      {stack.length > 0 && (
                        <ul
                          class="mt-3.5 flex flex-wrap gap-x-2 gap-y-1"
                          aria-label={t.projects.stack}
                        >
                          {stack.map(item => (
                            <li class="chip">{item}</li>
                          ))}
                        </ul>
                      )}
                    </div>

                    <div class="rail flex flex-col gap-1.5 sm:text-end">
                      {href && (
                        <a
                          href={href}
                          class="text-accent font-medium hover:underline"
                        >
                          {t.projects.projectPage}{" "}
                          <span aria-hidden="true">→</span>
                        </a>
                      )}
                      <span>{period}</span>
                      <span>{role}</span>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>
