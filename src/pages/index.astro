---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LangFallbackNotice from "@/components/LangFallbackNotice.astro";
import { getProjects } from "@/utils/getProjects";
import { useTranslations } from "@/i18n";

const locale = "zh-Hant" as const;
const t = useTranslations(locale);
const projects = await getProjects(locale);
---

<Layout>
  <Header />

  <main id="main-content" class="app-layout my-1">
    <LangFallbackNotice />

    <section id="hero" class="border-border border-b pt-8 pb-10">
      <h1 class="my-4 text-4xl font-bold sm:my-6 sm:text-5xl">
        {t.siteName}
      </h1>

      <p class="measure text-lg">
        全端工程師，專注於將大型語言模型落地為可信賴的產品 ——
        檢索增強生成（RAG）、自架模型推論與機器學習預測，
        以及支撐它們的後端、行動端與金流基礎建設。
      </p>

      <p class="measure text-muted-foreground mt-4">
        2026 年 6 月自國立勤益科技大學資訊工程系畢業，
        同年 9 月起就讀該校資訊工程研究所碩士班。現居台中。
      </p>
    </section>

    <section id="projects" class="pt-10 pb-6">
      <h2 class="text-2xl font-semibold">{t.projects.sectionTitle}</h2>
      <ul class="mt-2">
        {projects.map(project => <ProjectCard {project} />)}
      </ul>
    </section>

    <section id="contact" class="border-border border-t pt-8 pb-10">
      <h2 class="text-2xl font-semibold">{t.contact.sectionTitle}</h2>
      <p class="measure text-muted-foreground mt-2">
        歡迎來信討論研究、工作機會或這些專案的任何技術細節。
      </p>
      <div class="mt-4 flex flex-col gap-2">
        <a
          href="mailto:alan930604@gmail.com"
          class="hover:text-accent w-fit underline decoration-dashed underline-offset-4"
        >
          alan930604@gmail.com
        </a>
        <Socials />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
