---
import { Image } from "astro:assets";
import portrait from "@/assets/images/cheng-han-lin-portrait.jpg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import SectionRail from "@/components/SectionRail.astro";
import FeaturedProject from "@/components/FeaturedProject.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import LangFallbackNotice from "@/components/LangFallbackNotice.astro";
import { getProjects } from "@/utils/getProjects";
import { useTranslations } from "@/i18n";

const locale = "zh-Hant" as const;
const t = useTranslations(locale);
const projects = await getProjects(locale);

const [featured, ...others] = projects;
---

<Layout>
  <Header />

  <main id="main-content" class="app-layout">
    <LangFallbackNotice />

    {
      /* Chinese paragraphs must stay on one source line: JSX joins a soft line
        break with a space, which renders as a gap between Han characters.
        `npm run check:cjk` fails the build path if one creeps back in. */
    }
    <section id="hero" class="rail-grid pt-16 pb-14">
      <div>
        {
          /* Above the name rather than beside it: the rail is 200px, and a
            portrait that shares that column with the type would be too small
            to be a face. */
        }
        <Image
          src={portrait}
          alt="林承翰的個人照：站在白牆前，白色 T 恤配牛仔褲"
          class="border-border mb-5 w-full border"
          widths={[200, 400, 600]}
          sizes="(min-width: 64rem) 200px, 40vw"
        />

        <p class="rail">
          <span class="text-accent block">CHENG-HAN LIN</span>
          <span class="block">資訊工程碩士生</span>
          <span class="block">台中 · Taiwan</span>
          <span class="border-border mt-3.5 block border-t pt-3.5">
            RAG · 自架推論
          </span>
          <span class="block">ML · 後端 · 金流</span>
        </p>
      </div>

      <div class="measure">
        <h1 class="text-5xl leading-tight font-bold sm:text-6xl">
          {t.siteName}
        </h1>

        <p class="mt-6 text-xl">
          獨立開發過三個上線的產品。我做的是把大型語言模型變成可信賴的東西：以檢索增強生成（RAG）確保輸出可追溯、以自架推論守住敏感資料、以機器學習補足模型不擅長的預測，並獨力完成其後的後端、行動端與金流基礎建設。
        </p>

        <p class="text-muted-foreground mt-5">
          2026 年 6 月自國立勤益科技大學資訊工程系畢業，同年 9
          月起就讀該校資訊工程研究所碩士班。現居台中。
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-x-3.5 gap-y-3">
          <a
            href="/projects/heartbox/"
            class="bg-accent text-accent-foreground rounded-sm px-5 py-3 font-medium"
          >
            讀 HeartBox 案例研究 <span aria-hidden="true" class="font-mono"
              >→</span
            >
          </a>
          <a
            href="/resume/"
            class="border-border hover:border-accent hover:text-accent rounded-sm border px-4.5 py-3"
          >
            {t.nav.resume} · PDF
          </a>
          <a
            href="https://github.com/alanlin0604"
            class="rail hover:text-accent px-1 py-3"
          >
            GitHub
          </a>
        </div>
      </div>
    </section>

    {
      featured && (
        <SectionRail
          id="featured"
          index="01"
          title="代表作"
          meta={["畢業專題", "2025 – 2026"]}
        >
          <FeaturedProject project={featured} />
        </SectionRail>
      )
    }

    {
      others.length > 0 && (
        <SectionRail
          id="projects"
          index="02"
          title="其他專案"
          meta={["2026 年起"]}
        >
          {others.map(project => (
            <ProjectRow {project} />
          ))}
        </SectionRail>
      )
    }

    <SectionRail id="contact" index="03" title={t.contact.sectionTitle}>
      <div class="measure">
        <p class="text-lg">
          歡迎來信討論研究、工作機會或這些專案的任何技術細節。
        </p>

        <a
          href="mailto:alan930604@gmail.com"
          class="link-underline text-accent mt-3.5 inline-block font-mono text-xl font-medium"
        >
          alan930604@gmail.com
        </a>

        <div class="rail mt-6">
          <Socials variant="text" />
        </div>
      </div>
    </SectionRail>
  </main>

  <Footer />
</Layout>
