---
import ArticleDetail from "@/components/ArticleDetail.astro";
import {
  getArticlesIn,
  articleSlug,
  articleAlternates,
  type Article,
} from "@/utils/getArticles";

const LOCALE = "zh-Hant" as const;

export async function getStaticPaths() {
  const articles = await getArticlesIn("zh-Hant");
  return articles.map(article => ({
    params: { slug: articleSlug(article) },
    props: { article },
  }));
}

type Props = { article: Article };

const { article } = Astro.props;

// Translations pair by slug. Where one is missing the entry is null, so no
// hreflang is emitted for it and the switcher falls back with a notice.
const alternates = await articleAlternates(article);
---

<ArticleDetail {article} locale={LOCALE} {alternates} />
