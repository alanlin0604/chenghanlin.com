---
import { type CollectionEntry } from "astro:content";
import ProjectDetail from "@/components/ProjectDetail.astro";
import { getProjects } from "@/utils/getProjects";

const LOCALE = "en" as const;

export async function getStaticPaths() {
  const projects = await getProjects("en");
  return projects
    .filter(project => project.data.hasPage)
    .map(project => ({
      params: { slug: project.data.pageSlug },
      props: { project },
    }));
}

type Props = { project: CollectionEntry<"projects"> };

const { project } = Astro.props;

const alternates = {
  "zh-Hant": `/projects/${project.data.pageSlug}/`,
  en: Astro.url.pathname,
};
---

<ProjectDetail {project} locale={LOCALE} {alternates} />
