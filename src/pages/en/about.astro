---
import { getEntry } from "astro:content";
import AboutPage from "@/components/AboutPage.astro";

const about = await getEntry("pages", "en/about");

if (!about) {
  throw new Error("Missing content entry: src/content/pages/en/about.md");
}
---

<AboutPage
  page={about}
  locale="en"
  meta={["MSc student, CSIE", "Taichung, Taiwan"]}
/>
