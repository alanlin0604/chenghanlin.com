---
import { getEntry } from "astro:content";
import AboutPage from "@/components/AboutPage.astro";

const about = await getEntry("pages", "zh-hant/about");

if (!about) {
  throw new Error("Missing content entry: src/content/pages/zh-hant/about.md");
}
---

<AboutPage
  page={about}
  locale="zh-Hant"
  meta={["資訊工程碩士生", "台中 · Taiwan"]}
/>
