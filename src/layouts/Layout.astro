---
import { ClientRouter } from "astro:transitions";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import { getAlternates } from "@/utils/alternateUrls";
import {
  DEFAULT_LOCALE,
  HREFLANG,
  resolveLocale,
  type Locale,
} from "@/i18n/locales";
import { useTranslations } from "@/i18n";
import config from "@/config";
import "@/styles/global.css";
// Imported for its emitted URL, not its contents: the file is content-hashed by
// the build, so the preload hint cannot be written by hand.
import cjkRegular from "@/assets/fonts/noto-sans-tc-400.subset.woff2";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  /** Counterpart URLs for dynamic routes; see getAlternates(). */
  alternates?: Partial<Record<Locale, string | null>>;
};

const { site } = config;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
  title = t.siteName,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  alternates,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
// One feed, in the site's default language — see src/pages/rss.xml.ts. Every
// article now exists in both languages, so a feed carrying both would show each
// piece to the same subscriber twice.
const rssHref = getAssetPath("rss.xml");

// hreflang is only emitted for languages that actually have this page. Pointing
// a missing translation at a home page tells Google the two are equivalent when
// they are not, which is worse than omitting the tag. x-default goes to the
// default locale when it exists, since that is the URL shared in Chinese
// contexts and the one Google should fall back to.
const localeAlternates = getAlternates(Astro.url.pathname, locale, alternates);
const availableAlternates = localeAlternates.filter(entry => entry.exists);
const xDefault =
  availableAlternates.find(entry => entry.locale === DEFAULT_LOCALE) ??
  availableAlternates[0];
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={HREFLANG[locale]}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <!-- PNG fallback rather than .ico: no .ico is shipped, and linking one that
         does not exist costs every visitor a 404 request. -->
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={getAssetPath("favicon-32.png")}
    />
    <link rel="apple-touch-icon" href={getAssetPath("favicon-180.png")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!--
      Preload the regular CJK subset — on Chinese pages only.

      It is discovered late otherwise: the browser has to fetch and parse the
      stylesheet before it learns the face exists, and this is the largest
      single asset on the page. `font-display: swap` means text is never
      invisible, so the win is bringing the swap forward rather than unblocking
      paint.

      The locale guard matters more than the hint does. English pages render
      from the system stack and never reference this face (see the :lang(en)
      rule in global.css), so preloading it there would download ~165 KB that
      nothing uses — turning an optimisation into a regression on the pages
      that are currently fastest.
    -->
    {
      locale !== "en" && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={cjkRegular}
          crossorigin
        />
      )
    }

    <!-- Language alternates -->
    {
      availableAlternates.map(entry => (
        <link
          rel="alternate"
          hreflang={HREFLANG[entry.locale]}
          href={new URL(entry.href, Astro.site).href}
        />
      ))
    }
    {
      xDefault && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(xDefault.href, Astro.site).href}
        />
      )
    }

    <!--
      No <Font> tag for the monospace face on purpose.

      Astro emits one @font-face per format, and the `ttf` blocks carry no
      unicode-range — so they match every character and the browser pulls a
      56 KB TTF for anything the latin woff2 subset misses. That TTF exists
      only so satori can read it while generating the OG image at build time;
      it was never meant to reach a reader. Code on this site is a handful of
      inline spans, which the system monospace stack renders at zero cost, so
      the face is simply not served. The `fonts` entry stays in astro.config
      because the OG route still needs its build-time font data.
    -->

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={t.siteName} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.siteName}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Seeded with the light background and corrected below (and by theme.ts)
         once the active theme is known. An empty value leaves Android's browser
         chrome to guess during the first paint. -->
    <meta name="theme-color" content="#fdfdfd" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");
        // Correct the seeded theme-color before first paint, so the Android
        // browser chrome never flashes the light colour on a dark page.
        if (theme === "dark") {
          document
            .querySelector("meta[name='theme-color']")
            ?.setAttribute("content", "#1c2130");
        }
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-background text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <slot />
    <script>
      import "@/scripts/theme";
      import "@/scripts/codeCopy";
    </script>
  </body>
</html>
