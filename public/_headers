# Response headers for Cloudflare Workers static assets.
# Copied verbatim from public/ into dist/ at build time.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Everything under /_astro/ carries a content hash in its filename, so the
# bytes at a given URL never change. Without this the default is
# `max-age=0, must-revalidate`, which makes every repeat visit revalidate the
# stylesheet and both ~88 KB font subsets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
